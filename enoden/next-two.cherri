#define name 江ノ電 鎌倉駅 次発2本
#define color orange
#define glyph tram
#define from watch, search
#include 'actions/web'
#include 'actions/text'
#include 'actions/calendar'

// Read each invocation from official timetable; no cached services
const html = getText(downloadURL("https://www.enoden.co.jp/train/station/kamakura/time-table/"))
@parts = splitText(html, '<div class="time-schedule-row">')
@nowH = number(formatDate("{CurrentDate}", "Custom", "H"))
@nowM = number(formatDate("{CurrentDate}", "Custom", "m"))
@now = @nowH * 60
@now += @nowM
@best1 = 1500
@best2 = 1500
@line1 = ""
@line2 = ""

for row in @parts {
    @hours = matchText('time-schedule-td-hour">([0-9]{1,2})', @row)
    if @hours {
        @hstr = getMatchGroup(getFirstItem(@hours), 1)
        @h = number(@hstr)
        @cells = splitText(@row, '<div class="time-schedule-minute">')
        for cell in @cells {
            @minutes = matchText('<p class="num">([0-9]{1,2})</p>', @cell)
            if @minutes {
                @mstr = getMatchGroup(getFirstItem(@minutes), 1)
                @m = number(@mstr)
                @dest = "藤沢行"
                if @cell contains 'num cap">江' {
                    @dest = "江ノ島行"
                }
                if @cell contains 'num cap">極' {
                    @dest = "極楽寺行"
                }
                if @cell contains 'num cap">稲' {
                    @dest = "稲村ヶ崎行"
                }
                @pad = @mstr
                if @m < 10 {
                    @pad = "0{@mstr}"
                }
                @departure = @h * 60
                @departure += @m
                @delta = @departure - @now
                if @delta <= 0 {
                    @delta += 1440
                }
                @display = "{@hstr}:{@pad} {@dest} あと約{@delta}分"
                if @delta < @best1 {
                    @best2 = @best1
                    @line2 = @line1
                    @best1 = @delta
                    @line1 = @display
                } else {
                    if @delta < @best2 {
                        @best2 = @delta
                        @line2 = @display
                    }
                }
            }
        }
    }
}
if @best2 == 1500 {
    show("江ノ電 鎌倉駅\n公式時刻表の解析に失敗しました。\n時刻は表示しません。")
} else {
    show("江ノ電 鎌倉駅 →\n{@line1}\n{@line2}\n※定刻・毎回公式サイト取得")
}
